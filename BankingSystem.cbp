<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Secure Bank" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/bank" prefix_auto="1" extension_auto="1" />
				<Option working_dir="." />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/bank" prefix_auto="1" extension_auto="1" />
				<Option working_dir="." />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-std=c11" />
			<Add option="-Wall" />
			<Add option="-Wextra" />
			<Add directory="include" />
		</Compiler>
		<Unit filename="include/auth.h" />
		<Unit filename="include/bank.h" />
		<Unit filename="include/sha256.h" />
		<Unit filename="include/storage.h" />
		<Unit filename="include/ui.h" />
		<Unit filename="include/utils.h" />
		<Unit filename="src/auth.c"><Option compilerVar="CC" /></Unit>
		<Unit filename="src/bank.c"><Option compilerVar="CC" /></Unit>
		<Unit filename="src/main.c"><Option compilerVar="CC" /></Unit>
		<Unit filename="src/sha256.c"><Option compilerVar="CC" /></Unit>
		<Unit filename="src/storage.c"><Option compilerVar="CC" /></Unit>
		<Unit filename="src/ui.c"><Option compilerVar="CC" /></Unit>
		<Unit filename="src/utils.c"><Option compilerVar="CC" /></Unit>
		<Extensions />
	</Project>
</CodeBlocks_project_file>
